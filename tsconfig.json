{
  "compilerOptions": {
    "target": "ES6",                          /* Use a modern JS version */
    "module": "commonjs",                     /* Required for Node.js */
    "moduleResolution": "node",               /* Helps resolve JSON + Node modules */
    "esModuleInterop": true,                  /* Allow import/export interop */
    "resolveJsonModule": true,                /* <-- Import JSON directly */
    "strict": true,                           /* Keep strict mode */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
